{
  "ci": {
    "collect": {
      "url": [
        "https://stehlenauto-vercel.vercel.app/",
        "https://stehlenauto-vercel.vercel.app/collections/roof-racks",
        "https://stehlenauto-vercel.vercel.app/products/stehlen-universal-door-frame-mount-roof-rack",
        "https://stehlenauto-vercel.vercel.app/vehicle/ford-f-150",
        "https://stehlenauto-vercel.vercel.app/about",
        "https://stehlenauto-vercel.vercel.app/legal/warranty"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttling": { "cpuSlowdownMultiplier": 1 }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 1.0 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
