{
  "ci": {
    "collect": {
      "url": [
        "https://stehlenauto.com/",
        "https://stehlenauto.com/collections/roof-racks-baskets",
        "https://stehlenauto.com/products/2015-2026-ford-f-150-5-5ft-bed-hard-tri-fold-tonneau-cover-w-led",
        "https://stehlenauto.com/vehicle/ford-f-150",
        "https://stehlenauto.com/about",
        "https://stehlenauto.com/legal/warranty"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttling": { "cpuSlowdownMultiplier": 1 }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 1.0 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
