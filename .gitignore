# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# playwright artifacts (run logs, traces) — keep curated screenshots in docs/screenshots/
.playwright-mcp/
playwright-report/
test-results/

# stray screenshots in repo root — should live in docs/screenshots/<bucket>/ instead
/*.png
/*.jpg
/*.jpeg
/*.yml

# scratch / test artifacts directory
/tmp/

# design handoff archives — keep the extracted readable files, drop the binary archives
docs/design-handoffs/**/handoff.gz
docs/design-handoffs/**/handoff.tar

# CA fitment audit snapshot (regenerated by sync) + scheduler lock files
data/ca_fitment_snapshot.json
.claude/scheduled_tasks.lock

# v13 full-quality masters — keep local only, share versions are committed
public/videos/spot-clips/stehlen-tacoma-tonneau-spot-v13.mp4
public/videos/spot-clips/stehlen-tacoma-tonneau-spot-v13-silent.mp4

# v14 full-quality masters — keep local only, share is committed
public/videos/spot-clips/stehlen-tacoma-tonneau-spot-v14.mp4
public/videos/spot-clips/stehlen-tacoma-tonneau-spot-v14-silent.mp4
